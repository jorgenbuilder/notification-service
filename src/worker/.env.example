# Example environment for Node worker (src/worker/index.ts)
# Copy this file to .env and fill the values. The .env file is git-ignored.

# Public values (safe to share across environments but keep .env untracked):
# Use the Internet Computer (IC) public API host for mainnet
IC_HOST=https://icp-api.io
NOTIFICATION_CANISTER_ID=zjwxf-jyaaa-aaaao-a43ca-cai

# Secret value: do NOT commit. Add this only in your local .env
# Base64 of 32 or 64 bytes Ed25519 secret (seed or secret+public)
WORKER_ED25519_SECRET_KEY=<<<add_your_secret_here>>>