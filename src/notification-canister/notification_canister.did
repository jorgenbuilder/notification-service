type SubscriptionKeys = record {
  p256dh: text;
  auth: text;
};

type Subscription = record {
  endpoint: text;
  expirationTime: opt nat;
  keys: SubscriptionKeys;
  relayer: principal;
};

type NotificationBody = record {
  title: text;
  content: text;
  url: opt text;
  tag: opt text;
};

type EncryptedNotification = record {
  endpoint: text;
  contentEncoding: variant { aesgcm; aes128gcm };
  encrypted: opt record {
    localPublicKey: vec nat8;
    salt: vec nat8;
    cipherText: vec nat8;
  };
  context: record { principal; principal };
};

type HttpRequest = record {
  method: text;
  url: text;
  headers: vec record { 0: text; 1: text };
  body: blob;
};

type HttpResponse = record {
  status_code: nat16;
  headers: vec record { 0: text; 1: text };
  body: blob;
};

type RelayerInfo = record {
  relayer: principal;
  vapid_public_key: text;
  registeredAt: nat64;
  lastUpdatedAt: nat64;
  description: text;
};

service : () -> {
  // admin interface
  registerRelayer: (principal, text, text) -> ();

  // end-user interface
  listRelayers: () -> (vec RelayerInfo) query;
  getVapidPublicKey: (principal) -> (text) query;
  hasSubscription: (principal, text) -> (bool) query;
  subscribe: (principal, Subscription) -> ();
  unsubscribe: (principal, text) -> ();
  unsubscribeAll: (principal) -> ();

  // app owner interface
  sendNotifications: (vec record {
    0: principal;
    1: NotificationBody;
  }) -> (vec bool);

  // relayer interface
  updateRelayer: (text, text) -> ();
  peekQueue: (nat64) -> (record { items: vec EncryptedNotification; drained: bool }) query;
  popQueue: (nat64) -> ();
  reportBrokenSubscriptions: (vec record {
    application: principal;
    user: principal;
    endpoint: text;
  }) -> ();

  // system interface
  http_request: (HttpRequest) -> (HttpResponse) query;
}